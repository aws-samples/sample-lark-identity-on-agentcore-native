# Per-server build/runtime config, read by scripts/build-mcp.sh. Adding a new MCP
# server means adding a directory and one of these — the build script stays untouched.

# AgentCore runtime name is {prefix}_{RUNTIME_SUFFIX} (underscores required). Kept as
# "mcp" rather than "lark_cli" because the runtime already exists under that name;
# renaming it would orphan the old one.
RUNTIME_SUFFIX=mcp

# Container env, as "CONTAINER_KEY=SOURCE_ENV_VAR" pairs. The build script reads each
# SOURCE_ENV_VAR from its own environment (.env is already sourced) and passes the map
# as JSON, so values containing commas are safe.
RUNTIME_ENV_MAP="APP_ID=LARK_APP_ID LARK_DOMAIN=LARK_API_DOMAIN"
