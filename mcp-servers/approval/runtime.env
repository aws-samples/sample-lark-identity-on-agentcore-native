# Per-server build/runtime config, read by scripts/build-mcp.sh.

RUNTIME_SUFFIX=approval

# Skipped by a build-everything run unless this variable is set: with no allow-list
# the guards refuse every decision, so the server would cost a Runtime's build time
# and memory-time to do nothing. Naming it explicitly (`./deploy.sh mcp approval`)
# builds it regardless — an explicit request should not be second-guessed.
DEPLOY_IF=AGENT_DECIDE_APPROVAL_CODES

# Unlike lark-cli, this server mints a tenant token (approve/reject accept no user
# token), so it needs the real appSecret. The container carries no AWS SDK to read it
# from Secrets Manager, so it arrives as an environment variable — which widens where
# the secret lives: anyone who can read this runtime's config can read it. Worth
# knowing given that a tenant token can complete any approval in the tenant.
REQUIRE_VARS="LARK_APP_SECRET"

# AGENT_DECIDE_* are the code-enforced limits on what the agent may decide; an empty
# allow-list decides nothing (fail closed) until set deliberately in .env. The
# allow-list holds comma-separated approval codes, which is why the build script
# passes this map as JSON rather than the CLI's key=value shorthand — the shorthand
# splits on those commas and silently mangles the map.
RUNTIME_ENV_MAP="APP_ID=LARK_APP_ID APP_SECRET=LARK_APP_SECRET LARK_DOMAIN=LARK_API_DOMAIN AGENT_DECIDE_APPROVAL_CODES=AGENT_DECIDE_APPROVAL_CODES AGENT_DECIDE_MAX_AMOUNT=AGENT_DECIDE_MAX_AMOUNT"
